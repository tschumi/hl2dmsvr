"VertexLitGeneric"
{
	"$baseTexture" 	"models/gordon/hevsuit_sheet"
	"$bumpmap" "models/gordon/hevsuit_normal"
	$phongexponenttexture "models/gordon/HEVsuit_sheet_exp"
	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" 1
	"$envmapcontrast" 1
    	"$envmaptint" "[ 0.05 0.05 0.05 ]"
	"$selfillum" 1	
	"$detail" "models/HB_Common/med_detail1"	
	"$detailscale" 5

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponent" "5"
	"$phongboost"	"5"
	"$phongfresnelranges"	"[0.25 0.5 1.0]"
}